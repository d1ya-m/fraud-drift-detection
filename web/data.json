  "the_waiting_gap": {
    "title": "Why Detector-Triggered Retraining Trails Scheduled Retraining",
    "summary": "The entire deficit of detector-based maintenance stems from detection delay. Because fraud labels are extremely scarce (~13 frauds per 10,000 batch), statistical detectors take 1 to 9 batches to accumulate enough misses to alarm. Once alarmed, accumulate actually outperforms periodic retraining by +0.058 PR-AUC!",
    "phases": [
      {
        "phase": "Waiting for the Alarm",
        "batches": 210,
        "difference_pr_auc": -0.279,
        "interpretation": "Drift occurred, but detector has not accumulated enough rare fraud samples to alarm.",
        "status": "deficit"
      },
      {
        "phase": "Detector Never Fired",
        "batches": 84,
        "difference_pr_auc": -0.341,
        "interpretation": "Occurred on weaker drifts (2 pairs) where rise in miss rate was subtle.",
        "status": "deficit"
      },
      {
        "phase": "Accumulating After Alarm",
        "batches": 375,
        "difference_pr_auc": 0.058,
        "interpretation": "Once alarmed, accumulate refits on fresh batches and SURPASSES periodic retraining!",
        "status": "gain"
      },
      {
        "phase": "Post-Accumulation Steady State",
        "batches": 501,
        "difference_pr_auc": 0.0,
        "interpretation": "Fully caught up and parity restored with periodic retraining.",
        "status": "parity"
      }
    ],
    "fraud_frequency_vs_delay": [
      {
        "fraud_volume": "96 Frauds (Burst / 50% split)",
        "detection_delay": "1 Batch (~10,000 transactions)",
        "speed": "Fast"
      },
      {
